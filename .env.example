# --- Course-provided endpoint (OpenAI-compatible) ---
LLM_BASE_URL=https://your-course-endpoint/v1
LLM_API_KEY=sk-team-key-here
# `make probe` reports the endpoint's default model if this name is wrong
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
# "json_schema" | "json_object" | "none"  -- what the endpoint supports for structured output.
# Run `python -m finsight.llm --probe` to find out.
LLM_JSON_MODE=json_schema
# The endpoint rate-limits (HTTP 429) without advertising the limit. Requests are paced to LLM_MAX_RPM per
# minute and 429s are retried with exponential backoff. Lower LLM_MAX_RPM if `rate_limited` stays > 0.
LLM_MAX_RPM=20
LLM_MAX_RETRIES=6

EMBED_BASE_URL=https://your-course-endpoint/v1
EMBED_API_KEY=sk-team-key-here
EMBED_MODEL=BAAI/bge-small-en-v1.5
# "local" (CPU, no quota: `make index-local`) | "api" (only if the endpoint has /embeddings) | "none" (BM25 only)
# The course endpoint has no /embeddings route, so use local.
EMBED_BACKEND=local

# "none" | "cross-encoder" (needs `pip install .[rerank]`). On our gold set the reranker raised
# recall@10 (0.94 -> 0.97) but lowered recall@5 (0.92 -> 0.88), so it is off by default.
RERANKER=none
RERANKER_MODEL=BAAI/bge-reranker-base

# SEC asks every client to identify itself: "Name contact-email"
SEC_USER_AGENT=FinSight-Capstone your-team-email@example.com

# Agent guardrails
MAX_STEPS=10
MAX_TOKENS_PER_QUERY=12000
MAX_CRITIC_REVISIONS=2

# API guardrails
RATE_LIMIT_PER_MIN=20

# Optional Langfuse export
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
